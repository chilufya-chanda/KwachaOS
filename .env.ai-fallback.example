# AI routing order:
# 1. Every model in GROQ_MODELS, left to right
# 2. OpenRouter
# 3. Mistral
# 4. Gemini (last fallback)

GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,llama-3.3-70b-versatile,llama-3.1-8b-instant

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

AI_PROVIDER_COOLDOWN_MS=60000
AI_PROVIDER_TIMEOUT_MS=45000
